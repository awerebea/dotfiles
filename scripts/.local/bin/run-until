#!/usr/bin/env bash

# Function implementation that can access aliases and shell functions
run_until() {
    # ZSH compatibility: only set pipefail in bash, avoid set -u in ZSH
    if [[ -n "${BASH_VERSION:-}" ]]; then
        set -uo pipefail
    fi

    # Canonical program name for the version output (GNU: a constant, never
    # derived from $0). Locals, not readonly globals: this file is sourced
    # into interactive shells, where re-sourcing would fail on readonly.
    local prog_name="run-until"
    # Semantic version: MAJOR for breaking CLI or behavior changes, MINOR for
    # new features, PATCH for fixes. Bump it with every change to this script.
    local version="1.0.0"

    # Usage function
    usage() {
        local script_name="${FUNCNAME[1]:-run_until}"

        cat >&2 <<EOF
$prog_name $version
Usage: $script_name <mode> [options] -c "<command>"
       $script_name <mode> [options] -- <command> [args...]
       $script_name version | --version

Modes:
  s, success   Continue executing the command until the first success
  f, fail      Continue executing the command until the first failure
  version      Print the version and exit (also --version)

Options:
  -t, --timeout SECONDS           Total timeout in seconds (positive float)
                                  [default: no timeout]
  -p, --pause SECONDS             Pause between iterations (non-negative float)
                                  [default: 5 seconds]
  -i, --pause-increment SECONDS   Increment to pause on each iteration (float, can be negative)
                                  [default: 0]
  -m, --pause-multiplier FLOAT    Multiply pause on each iteration (positive float)
                                  [default: 1]
  -M, --pause-max SECONDS         Maximum pause value (positive float)
                                  [default: no limit]
  -c, --command "COMMAND"         Command to execute, as a single string,
                                  same as \`bash -c\` (required unless --
                                  is used; mutually exclusive with --)
  --                              Treat everything after this as the
                                  command and its arguments, each as a
                                  separate word (mutually exclusive with
                                  -c/--command)
EOF
        return 1
    }

    # Defaults
    timeout=""
    pause=5
    pause_increment=0
    pause_multiplier=1
    pause_max=""
    cmd=()
    cmd_source=""

    # `version` as the first argument prints the version and exits
    case "${1:-}" in
    version | --version)
        printf '%s %s\n' "$prog_name" "$version"
        return 0
        ;;
    esac

    # Validate first positional argument
    if [[ $# -lt 2 ]]; then
        usage
        return 1
    fi

    mode=$1
    shift

    case "$mode" in
    s | success) mode="success" ;;
    f | fail) mode="fail" ;;
    *)
        echo "Error: first argument must be 'success' or 'fail'" >&2
        usage
        return 1
        ;;
    esac

    # Short options that require a value. Used by the squash-expansion below
    # to stop mid-token once one of these is hit: a value-taking short
    # option consumes the rest of its token (or the next argv item, if
    # nothing is left) as its value, and nothing after it is treated as
    # more flags -- same GNU/POSIX convention as `tar -xvf file` (note -f
    # must come last). -c/--command only ever takes a single value (like
    # `bash -c`), so it's an ordinary member here; only a bare `--` swallows
    # everything after it verbatim and must not be touched by squashing.
    local value_opts="tpiMmc"

    # Expand squashed short options into separate tokens so the parsing
    # loop below can handle them one at a time, same as `ls -la`.
    local expanded=() chars i c rest stop_expanding=0 take_value=0
    while [[ $# -gt 0 ]]; do
        if [[ "$stop_expanding" -eq 1 || "$take_value" -eq 1 ]]; then
            # After '--', or the value of the previous option: keep as-is,
            # even if it starts with '-'
            expanded+=("$1")
            take_value=0
            shift
            continue
        fi
        case "$1" in
        --)
            expanded+=("$1")
            stop_expanding=1
            ;;
        --*)
            expanded+=("$1")
            ;;
        -?*)
            chars="${1#-}"
            for ((i = 0; i < ${#chars}; i++)); do
                c="${chars:$i:1}"
                expanded+=("-$c")
                case "$value_opts" in
                *"$c"*)
                    rest="${chars:$((i + 1))}"
                    if [[ -n "$rest" ]]; then
                        expanded+=("$rest")
                    else
                        take_value=1
                    fi
                    break
                    ;;
                esac
            done
            ;;
        *)
            expanded+=("$1")
            ;;
        esac
        shift
    done
    set -- "${expanded[@]}"

    # Argument parsing
    while [[ $# -gt 0 ]]; do
        # Options taking a separate value need one more argument
        case "$1" in
        -t | --timeout | -p | --pause | -i | --pause-increment | -m | --pause-multiplier | \
            -M | --pause-max | -c | --command)
            if [[ $# -lt 2 ]]; then
                echo "Error: $1 requires a value" >&2
                usage
                return 1
            fi
            ;;
        esac

        case "$1" in
        -t | --timeout)
            shift
            timeout="$1"
            ;;
        --timeout=*) timeout="${1#*=}" ;;
        -p | --pause)
            shift
            pause="$1"
            ;;
        --pause=*) pause="${1#*=}" ;;
        -i | --pause-increment)
            shift
            pause_increment="$1"
            ;;
        --pause-increment=*) pause_increment="${1#*=}" ;;
        -m | --pause-multiplier)
            shift
            pause_multiplier="$1"
            ;;
        --pause-multiplier=*) pause_multiplier="${1#*=}" ;;
        -M | --pause-max)
            shift
            pause_max="$1"
            ;;
        --pause-max=*) pause_max="${1#*=}" ;;
        -c | --command)
            if [[ "$cmd_source" == "--" ]]; then
                echo "Error: -c/--command and -- are mutually exclusive" >&2
                usage
                return 1
            fi
            shift
            cmd=("$1")
            cmd_source="-c"
            ;;
        --command=*)
            if [[ "$cmd_source" == "--" ]]; then
                echo "Error: -c/--command and -- are mutually exclusive" >&2
                usage
                return 1
            fi
            cmd=("${1#*=}")
            cmd_source="-c"
            ;;
        --version)
            printf '%s %s\n' "$prog_name" "$version"
            return 0
            ;;
        --)
            if [[ "$cmd_source" == "-c" ]]; then
                echo "Error: -c/--command and -- are mutually exclusive" >&2
                usage
                return 1
            fi
            shift
            cmd=("$@")
            cmd_source="--"
            break
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage
            return 1
            ;;
        esac
        shift
    done

    if [[ ${#cmd[@]} -eq 0 ]]; then
        echo "Error: command must be specified with -c or --command" >&2
        usage
        return 1
    fi

    # Validation functions
    validate_float() {
        local val=$1 name=$2
        printf "%f" "$val" >/dev/null 2>&1 || {
            echo "Error: $name must be a number" >&2
            return 1
        }
    }

    validate_positive() {
        local val=$1 name=$2
        validate_float "$val" "$name"
        awk "BEGIN {if($val <= 0) exit 1}" || {
            echo "Error: $name must be positive" >&2
            return 1
        }
    }

    validate_non_negative() {
        local val=$1 name=$2
        validate_float "$val" "$name"
        awk "BEGIN {if($val < 0) exit 1}" || {
            echo "Error: $name must be non-negative" >&2
            return 1
        }
    }

    # Validate inputs
    [[ -n "$timeout" ]] && validate_positive "$timeout" "timeout"
    [[ -n "$pause" ]] && validate_non_negative "$pause" "pause"
    validate_float "$pause_increment" "pause-increment"
    validate_positive "$pause_multiplier" "pause-multiplier"
    [[ -n "$pause_max" ]] && validate_non_negative "$pause_max" "pause-max"

    # Clamp initial pause to pause-max if needed
    if [[ -n "$pause_max" && $(awk "BEGIN {print ($pause > $pause_max)}") -eq 1 ]]; then
        pause="$pause_max"
    fi

    # Timing
    start_time=$(date +%s.%N)
    current_pause="$pause"
    local cmd_status=0

    while :; do
        echo "Executing command: ${cmd[*]}"
        eval "${cmd[*]}"
        local cmd_status=$?

        # Exit condition
        if [[ "$mode" == "success" && $cmd_status -eq 0 ]] || [[ "$mode" == "fail" && $cmd_status -ne 0 ]]; then
            break
        fi

        # Timeout check
        if [[ -n "$timeout" ]]; then
            now=$(date +%s.%N)
            elapsed=$(awk "BEGIN {print $now - $start_time}")
            remaining=$(awk "BEGIN {print $timeout - $elapsed}")
            if (($(awk "BEGIN {print ($remaining <= 0)}"))); then
                echo "Timeout reached ($timeout s)" >&2
                return 1
            fi
        fi

        # Pause before next iteration (timeout-aware)
        if [[ -n "$current_pause" && $(awk "BEGIN {print ($current_pause>0)}") -eq 1 ]]; then
            if [[ -n "$timeout" && $(awk "BEGIN {print ($current_pause >= $remaining)}") -eq 1 ]]; then
                echo "Next pause ($current_pause s) would exceed timeout. Exiting loop." >&2
                break
            fi
            echo "Sleeping for: ${current_pause} sec."
            sleep "$current_pause"
        fi

        # Update pause: multiply then increment
        if [[ -n "$current_pause" ]]; then
            current_pause=$(awk "BEGIN {v=$current_pause * $pause_multiplier + $pause_increment; if(v<0) v=0; print v}")
            # Clamp to pause-max
            if [[ -n "$pause_max" && $(awk "BEGIN {print ($current_pause > $pause_max)}") -eq 1 ]]; then
                current_pause="$pause_max"
            fi
        fi
    done

    return "$cmd_status"
}

# When sourced, just define the function. When executed, run it.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    # Script is being executed directly
    run_until "$@"
    exit $?
fi
