                        { "type": "variable_if", "name": "space_layer", "value": 1 }
                    ]
                },
                {
                    "type": "basic",
                    "from": { "key_code": "open_bracket", "modifiers": { "optional": ["any"] } },
                    "to": [{ "key_code": "4", "modifiers": ["left_command", "left_shift"] }],
                    "conditions": [
                        { "type": "device_unless", "identifiers": [{ "vendor_id": 13364, "product_id": 480 }] },
                        { "type": "variable_if", "name": "space_layer", "value": 1 }
                    ]
                },
                {
                    "type": "basic",
                    "from": { "key_code": "close_bracket", "modifiers": { "optional": ["any"] } },
                    "to": [{ "key_code": "4", "modifiers": ["left_command", "left_shift"] }],
                    "conditions": [
                        { "type": "device_unless", "identifiers": [{ "vendor_id": 13364, "product_id": 480 }] },
