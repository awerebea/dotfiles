                    ]
                },
                {
                    "type": "basic",
                    "from": { "key_code": "u", "modifiers": { "optional": ["any"] } },
                    "to": [{ "key_code": "page_up" }],
                    "conditions": [
                        { "type": "device_unless", "identifiers": [{ "vendor_id": 13364, "product_id": 480 }] },
                        { "type": "variable_if", "name": "space_layer", "value": 1 }
                    ]
                },
                {
                    "type": "basic",
                    "from": { "key_code": "m", "modifiers": { "optional": ["any"] } },
                    "to": [{ "key_code": "page_down" }],
                    "conditions": [
                        { "type": "device_unless", "identifiers": [{ "vendor_id": 13364, "product_id": 480 }] },
                        { "type": "variable_if", "name": "space_layer", "value": 1 }
                    ]
                },
                {
                    "type": "basic",
                    "from": { "key_code": "backslash", "modifiers": { "optional": ["any"] } },
                    "to": [{ "key_code": "pause" }],
                    "conditions": [
                        { "type": "device_unless", "identifiers": [{ "vendor_id": 13364, "product_id": 480 }] },
                        { "type": "variable_if", "name": "space_layer", "value": 1 }
                    ]
                },
                {
                    "type": "basic",
                    "from": { "key_code": "semicolon", "modifiers": { "optional": ["any"] } },
                    "to": [{ "key_code": "end" }],
                    "conditions": [
