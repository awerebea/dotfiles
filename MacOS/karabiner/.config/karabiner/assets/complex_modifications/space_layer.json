{
    "title": "Space Layer (excludes Keychron Q11)",
    "rules": [
        {
            "description": "Hold Space for a navigation/modifier layer: h/j/k/l = arrows, a/s/d/f = Gui/Alt/Ctrl/Shift, g/e = Enter, r/o = Forward Delete, u = Page Up, m = Page Down, 0/i = Home, 4/, = End, ;= Insert, \\ = Pause, [ and ] = Cmd+Shift+4 (screenshot). Space alone still types a space when tapped. Excluded from the Keychron Q11.",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "spacebar",
                        "modifiers": { "optional": ["any"] }
                    },
                    "to_if_alone": [{ "key_code": "spacebar" }],
                    "to_if_held_down": [
                        { "set_variable": { "name": "space_layer", "value": 1 } }
                    ],
                    "to_after_key_up": [
                        { "set_variable": { "name": "space_layer", "value": 0 } }
                    ],
                    "parameters": {
                        "basic.to_if_alone_timeout_milliseconds": 200,
                        "basic.to_if_held_down_threshold_milliseconds": 200
                    },
                    "conditions": [
                        {
                            "type": "device_unless",
                            "identifiers": [
                                { "vendor_id": 13364, "product_id": 480 }
                            ]
                        },
                        {
                            "type": "variable_unless",
                            "name": "caps_word",
                            "value": 1
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": { "key_code": "h", "modifiers": { "optional": ["any"] } },
                    "to": [{ "key_code": "left_arrow" }],
                    "conditions": [
                        { "type": "device_unless", "identifiers": [{ "vendor_id": 13364, "product_id": 480 }] },
                        { "type": "variable_if", "name": "space_layer", "value": 1 }
                    ]
                },
                {
                    "type": "basic",
                    "from": { "key_code": "j", "modifiers": { "optional": ["any"] } },
                    "to": [{ "key_code": "down_arrow" }],
                    "conditions": [
                        { "type": "device_unless", "identifiers": [{ "vendor_id": 13364, "product_id": 480 }] },
                        { "type": "variable_if", "name": "space_layer", "value": 1 }
                    ]
                },
                {
                    "type": "basic",
                    "from": { "key_code": "k", "modifiers": { "optional": ["any"] } },
                    "to": [{ "key_code": "up_arrow" }],
                    "conditions": [
                        { "type": "device_unless", "identifiers": [{ "vendor_id": 13364, "product_id": 480 }] },
                        { "type": "variable_if", "name": "space_layer", "value": 1 }
                    ]
                },
                {
                    "type": "basic",
                    "from": { "key_code": "l", "modifiers": { "optional": ["any"] } },
                    "to": [{ "key_code": "right_arrow" }],
                    "conditions": [
                        { "type": "device_unless", "identifiers": [{ "vendor_id": 13364, "product_id": 480 }] },
                        { "type": "variable_if", "name": "space_layer", "value": 1 }
                    ]
                },
                {
                    "type": "basic",
                    "from": { "key_code": "a", "modifiers": { "optional": ["any"] } },
                    "to": [{ "key_code": "left_command" }],
                    "conditions": [
                        { "type": "device_unless", "identifiers": [{ "vendor_id": 13364, "product_id": 480 }] },
                        { "type": "variable_if", "name": "space_layer", "value": 1 }
                    ]
                },
                {
                    "type": "basic",
                    "from": { "key_code": "s", "modifiers": { "optional": ["any"] } },
                    "to": [{ "key_code": "left_option" }],
                    "conditions": [
                        { "type": "device_unless", "identifiers": [{ "vendor_id": 13364, "product_id": 480 }] },
                        { "type": "variable_if", "name": "space_layer", "value": 1 }
                    ]
                },
                {
                    "type": "basic",
                    "from": { "key_code": "d", "modifiers": { "optional": ["any"] } },
                    "to": [{ "key_code": "left_control" }],
                    "conditions": [
                        { "type": "device_unless", "identifiers": [{ "vendor_id": 13364, "product_id": 480 }] },
                        { "type": "variable_if", "name": "space_layer", "value": 1 }
                    ]
                },
                {
                    "type": "basic",
                    "from": { "key_code": "f", "modifiers": { "optional": ["any"] } },
                    "to": [{ "key_code": "left_shift" }],
                    "conditions": [
                        { "type": "device_unless", "identifiers": [{ "vendor_id": 13364, "product_id": 480 }] },
                        { "type": "variable_if", "name": "space_layer", "value": 1 }
                    ]
                },
                {
                    "type": "basic",
                    "from": { "key_code": "g", "modifiers": { "optional": ["any"] } },
                    "to": [{ "key_code": "return_or_enter" }],
                    "conditions": [
                        { "type": "device_unless", "identifiers": [{ "vendor_id": 13364, "product_id": 480 }] },
                        { "type": "variable_if", "name": "space_layer", "value": 1 }
                    ]
