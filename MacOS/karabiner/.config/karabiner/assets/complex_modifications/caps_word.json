{
    "title": "Caps Word (Shift+Shift toggle, excludes Keychron Q11)",
    "rules": [
        {
            "description": "Press left_shift+right_shift to toggle Caps Word: subsequent letters (including the GACS home-row-mod letters a/s/d/f/h/j/k/l) are auto-capitalized until Space/Enter/Tab/Escape, punctuation other than -/_, or the same chord again. Excluded from the Keychron Q11, which already implements this in firmware via Vial.",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "simultaneous": [
                            { "key_code": "left_shift" },
                            { "key_code": "right_shift" }
                        ],
                        "simultaneous_options": {
                            "key_down_order": "insensitive",
                            "key_up_order": "insensitive",
                            "detect_key_down_uninterruptedly": true
                        }
                    },
                    "to": [{ "set_variable": { "name": "caps_word", "value": 1 } }],
                    "conditions": [
                        {
                            "type": "device_unless",
                            "identifiers": [
                                { "vendor_id": 13364, "product_id": 480 }
                            ]
                        },
                        { "type": "variable_unless", "name": "caps_word", "value": 1 }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "simultaneous": [
                            { "key_code": "left_shift" },
                            { "key_code": "right_shift" }
                        ],
                        "simultaneous_options": {
                            "key_down_order": "insensitive",
                            "key_up_order": "insensitive",
                            "detect_key_down_uninterruptedly": true
                        }
                    },
                    "to": [{ "set_variable": { "name": "caps_word", "value": 0 } }],
                    "conditions": [
                        {
                            "type": "device_unless",
                            "identifiers": [
                                { "vendor_id": 13364, "product_id": 480 }
                            ]
                        },
                        { "type": "variable_if", "name": "caps_word", "value": 1 }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "spacebar",
                        "modifiers": { "optional": ["any"] }
                    },
                    "to": [
                        { "key_code": "spacebar" },
                        { "set_variable": { "name": "caps_word", "value": 0 } }
                    ],
                    "conditions": [
                        { "type": "variable_if", "name": "caps_word", "value": 1 }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "return_or_enter",
                        "modifiers": { "optional": ["any"] }
                    },
                    "to": [
                        { "key_code": "return_or_enter" },
                        { "set_variable": { "name": "caps_word", "value": 0 } }
