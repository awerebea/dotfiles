{
    "title": "GACS Home Row Mods (left modifiers only, excludes Keychron Q11)",
    "rules": [
        {
            "description": "A/S/D/F and J/K/L/; become Gui/Alt/Ctrl/Shift when held, letters when tapped. All events use left_* modifiers on both hands. Excluded from the Keychron Q11, which already implements this in firmware via Vial.",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "a",
                        "modifiers": { "optional": ["any"] }
                    },
                    "to_if_alone": [{ "key_code": "a" }],
                    "to_if_held_down": [{ "key_code": "left_command" }],
                    "parameters": {
                        "basic.to_if_alone_timeout_milliseconds": 200,
                        "basic.to_if_held_down_threshold_milliseconds": 200
                    },
                    "conditions": [
                        {
                            "type": "device_unless",
                            "identifiers": [
                                { "vendor_id": 13364, "product_id": 480 }
                            ]
                        },
                        {
                            "type": "variable_unless",
                            "name": "caps_word",
                            "value": 1
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "s",
                        "modifiers": { "optional": ["any"] }
                    },
                    "to_if_alone": [{ "key_code": "s" }],
                    "to_if_held_down": [{ "key_code": "left_option" }],
                    "parameters": {
