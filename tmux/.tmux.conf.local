set -g @floax-text-color "blue"
set -g @floax-change-path "true"


set -g @plugin 'graemedavidson/tmux-pane-focus'
# Press <prefix> + T to override settings for the current window
set -g @pane-focus-size '50'
set -g @pane-focus-direction '-'


set -g @plugin 'spywhere/tmux-named-snapshot'
set -g @named-snapshot-switch-client 'N:tns'
set -g @named-snapshot-save 'm:manual p:* d:dev'
set -g @named-snapshot-restore 'M:manual P:* D:dev'


set -g @plugin 'trevarj/tmux-open-nvim'
set -g @ton-open-strategy ":e"

set -g @plugin 'kristopolous/tmux-gentrify'
set -g @plugin 'jonmosco/kube-tmux'
# }}} --------------- end of plugins settings -----------------------------------------------------

# -- native replacements for removed plugins ---------------------------------

bind a last-window       # prefix a == prefix Tab, since prefix is C-a
bind C-p previous-window
bind C-n next-window

# tmux-power-zoom's trigger key: it moved the active pane into its own new
# window, then moved it back to its original spot on a second press --
# not the same thing as tmux's native `resize-pane -Z` (which zooms a pane
# in place, no window created). The real native equivalent is `break-pane`
# / `join-pane`, which is what tmux-power-zoom used internally anyway
# (its own source: "This plugin relies on using break-pane, and on tmux
# 3.7 using this causes tmux to crash instantly...", the same crash risk
# noted where the plugin was removed above). Tested `break-pane` directly
# on this machine's tmux 3.7b in an isolated session: it does not crash.
# @zoomed_from is a per-PANE option (set with `-p`), so it travels with
# the pane through break-pane/join-pane and supports zooming more than
# one pane out at a time independently -- the original plugin tracked a
# single global @power_zoom_state, so this is actually a small
# improvement, not just a port.
bind Z run-shell "zf=\$(tmux display -pt '#{pane_id}' '#{@zoomed_from}' 2>/dev/null); if [ -n \"\$zf\" ];\
  then tmux join-pane -s '#{pane_id}' -t \"\$zf\"; tmux set-option -pu -t '#{pane_id}'\
  @zoomed_from; else tmux set-option -p -t '#{pane_id}' @zoomed_from '#{window_id}';\
  tmux break-pane -s '#{pane_id}'; fi"

# Show pane details.
set -g pane-border-status top
# Add in setting below to indicate: #D - Unique pane ID, #{pane_current_command} - running command
# Catppuccin Mocha: green #a6e3a1 (active), overlay1 #7f849c (inactive) --
# this is a plain native tmux directive, outside Oh My Tmux's
# tmux_conf_theme_* system entirely, so it was missed in the first
# Catppuccin pass (which only touched tmux_conf_theme_* variables).
set -g pane-border-format '[#[bold]#{?pane_active,#[fg=#a6e3a1],#[fg=#7f849c]}#P#[fg=default,nobold]]\
#{?pane_active,#[bold]#[fg=#a6e3a1],#[fg=default]}-#[fg=default,nobold]\
[#{?pane_active,#[bold]#[fg=#a6e3a1],#[fg=#7f849c]}#{pane_current_command}#[fg=default,nobold]]'

# unbind C-l # conflicts with pane movements
# bind l send-keys 'C-l' # clear screen (conflicts with nested session)

#vim navigation
is_vim="ps -o state= -o comm= -t '#{pane_tty}' \
  | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?g?(view|n?vim?x?)(diff)?$'"

is_fzf="ps -o state= -o comm= -t '#{pane_tty}' \
  | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?fzf$'"

# Jump to pane by index
bind-key C-j command-prompt -p "Jump to pane index:" "select-pane -t '%%'"

bind -n C-h run "($is_vim && tmux send-keys C-h) || tmux select-pane -L"

bind -n C-j run "($is_vim && tmux send-keys C-j)  || \
                    ($is_fzf && tmux send-keys C-j) || tmux select-pane -D"

bind -n C-k run "($is_vim && tmux send-keys C-k) || \
                    ($is_fzf && tmux send-keys C-k)  || tmux select-pane -U"

bind -n C-l run "($is_vim && tmux send-keys C-l) || tmux select-pane -R"

bind -n 'C-\' if-shell "$is_vim" "send-keys 'C-\\'" "select-pane -l"

# clear both screen and history
bind -n M-l run "($is_vim && tmux send-keys M-l) || \
                    (tmux send-keys C-l; sleep 0.1; tmux clear-history)"

# focus events enabled for terminals that support them
set -g focus-events on

# super useful when using "grouped sessions" and multi-monitor setup
setw -g aggressive-resize on

# -- clipboard -----------------------------------------------------------------
# Reverted back to true (this repo's original value) after tracing a real
# `prefix+r` crash ("unknown command: tmux" from a generated temp file) to
# changing this to false. Oh My Tmux's own `_apply_bindings` rewrites every
# copy-pipe/copy-selection binding it finds whenever a local clipboard tool
# is detected (pbcopy here) -- regardless of true/false/disabled, since
# that's a *separate* outer check. `true` takes the "insert pbcopy" branch,
# whose regex has a negative lookahead that skips any binding that already
# mentions pbcopy anywhere in the line. `false` (and `disabled` -- verified,
# it hits the exact same branch, not a safer no-op) takes the "strip
# pbcopy" branch, whose regex has no such guard: on tmux-yank's own
# `M-y` binding (`copy-pipe-and-cancel "pbcopy; tmux paste-buffer -p"`,
# not something in this file -- tmux-yank installs it), it strips the
# opening quote but the closing quote it's looking for isn't immediately
# after "pbcopy" (there's a "; tmux paste-buffer -p" first), so the
# closing quote is left orphaned, unbalancing the whole line and cascading
# into the next one. Reproduced by hand against a real capture of this
# session's actual `list-keys` output before concluding this -- `true`
# leaves the binding untouched (it already has pbcopy, so the lookahead
# blocks the rewrite) and the generated file sources cleanly; `false`
# corrupts it every time. So the "redundant with tmux-yank" framing this
# doc used before was true only in the sense of what ends up in your OS
# clipboard -- it was never redundant from a binding-rewrite-safety
# perspective, and turning it off is what broke reload. set-clipboard
# below is unrelated and still worth keeping: it makes tmux also emit
# OSC 52, so copies reach the host terminal's clipboard over SSH or from
# inside a nested tmux, which neither this setting nor tmux-yank's local
# pbcopy/xclip path covers on their own.
tmux_conf_copy_to_os_clipboard=true
set -s set-clipboard on

# -- display -------------------------------------------------------------------
# Catppuccin Mocha palette (https://catppuccin.com/palette -- Mocha flavor):
#   base #1e1e2e  mantle #181825  surface0 #313244  surface1 #45475a
#   surface2 #585b70  overlay0 #6c7086  overlay1 #7f849c  overlay2 #9399b2
#   subtext0 #a6adc8  subtext1 #bac2de  text #cdd6f4
#   rosewater #f5e0dc  flamingo #f2cdcd  pink #f5c2e7  mauve #cba6f7
#   red #f38ba8  maroon #eba0ac  peach #fab387  yellow #f9e2af
#   green #a6e3a1  teal #94e2d5  sky #89dceb  sapphire #74c7ec
#   blue #89b4fa  lavender #b4befe
# Every hex below is one of these, kept in the same semantic role (border /
# active-border / message / etc.) the previous Tokyo-Night-ish palette used.

# pane borders colours:
tmux_conf_theme_pane_border='#45475a'                   # surface1
tmux_conf_theme_pane_active_border='#a6e3a1'            # green

# pane indicator colours
tmux_conf_theme_pane_indicator='#a6e3a1'                # green
tmux_conf_theme_pane_active_indicator='#a6e3a1'         # green

# status line style
tmux_conf_theme_message_fg='#1e1e2e'                    # base
tmux_conf_theme_message_bg='#f9e2af'                    # yellow
tmux_conf_theme_message_attr='bold'

# status line command style (<prefix> : Escape)
tmux_conf_theme_message_command_fg='#f9e2af'            # yellow
tmux_conf_theme_message_command_bg='#1e1e2e'            # base
tmux_conf_theme_message_command_attr='bold'

# window modes style
tmux_conf_theme_mode_fg='#1e1e2e'                       # base
tmux_conf_theme_mode_bg='#f9e2af'                       # yellow
tmux_conf_theme_mode_attr='bold'

# status line style
tmux_conf_theme_status_fg='#a6adc8'                     # subtext0
tmux_conf_theme_status_bg='#1e1e2e'                     # base
tmux_conf_theme_status_attr='none'

# window status style
tmux_conf_theme_window_status_fg='#7f849c'              # overlay1
tmux_conf_theme_window_status_bg='#1e1e2e'              # base
tmux_conf_theme_window_status_attr='none'
tmux_conf_theme_window_status_format='#I #W#{?window_bell_flag,🔔,}#{?window_zoomed_flag,🔍,}'

# window current status style
tmux_conf_theme_window_status_current_fg='#1e1e2e'      # base
tmux_conf_theme_window_status_current_bg='#a6e3a1'      # green
tmux_conf_theme_window_status_current_attr='bold'
tmux_conf_theme_window_status_current_format='#I #W#{?window_zoomed_flag, 🔍,}'

# window bell status style
tmux_conf_theme_window_status_bell_fg='#f38ba8'         # red
tmux_conf_theme_window_status_bell_bg='default'
tmux_conf_theme_window_status_bell_attr='blink,bold'

# window last status style
tmux_conf_theme_window_status_last_fg='#a6e3a1'         # green
tmux_conf_theme_window_status_last_bg='default'
tmux_conf_theme_window_status_last_attr='bold'

# status left/right content:
# NOTE: each #[...] style directive below is deliberately split into
# separate single-attribute directives (#[bg=X]#[fg=Y], not #[bg=X,fg=Y]).
# A comma-separated multi-attribute directive nested inside a #{?a,b,c}
# conditional breaks tmux's parser -- confirmed with `tmux display -p`,
# even with the comma backslash-escaped -- and silently collapses the
# *entire* conditional to empty, not just that branch. Back-to-back
# single-attribute directives are the verified-working form.
tmux_conf_theme_status_left='#{?client_prefix,#[bg=#fab387]#[fg=#1e1e2e]\
WAIT ,#{?pane_in_mode,#[bg=#f9e2af]#[fg=#1e1e2e] COPY ,#{?pane_synchronized,#[bg=#f38ba8]#[fg=#1e1e2e] SYNC ,#[bg=#89b4fa]#[fg=#1e1e2e] TMUX }}}#[default]| ❐ #S |\
#[fg=#cdd6f4,bg=#45475a] [#{@pane-focus-direction}][#{@pane-focus-size}]#[fg=default,bg=default] {kube_tmux}'

# `#{online_status}`/`@is_online` (dead custom function, never activated --
# see section on dead segments) is dropped from the end.
tmux_conf_theme_status_right='#[fg=#f38ba8,bold]#(\
  [ $(tmux show-option -qv key-table) = 'suspended' ] && echo 'SUSPEND\ MODE'\
)#[fg=default]\
#{prefix}\
#{mouse}\
#{pairing}\
#{synchronized}\
#{?battery_vbar, #{battery_vbar},}#{?battery_percentage, #{battery_percentage},}\
 #[fg=#f9e2af]󰍛 #{sysstat_cpu} (#{sysstat_loadavg}) 󰆼 #{sysstat_mem} #[fg=default]\
%a %F %R\
 ↑#{?uptime_y, #{uptime_y}y,}#{?uptime_d, #{uptime_d}d,}#{?uptime_h, #{uptime_h}h,}#{?uptime_m, #{uptime_m}m,}\
 | #{username}#{root} | #{hostname} '

# status left style
tmux_conf_theme_status_left_fg='#1e1e2e,#1e1e2e,#a6e3a1,#cdd6f4'          # base,base,green,text
tmux_conf_theme_status_left_bg='#94e2d5,#b4befe,#45475a,#89b4fa'         # teal,lavender,surface1,blue
tmux_conf_theme_status_left_attr='bold,none,none'

# status right style
tmux_conf_theme_status_right_fg='#7f849c,#7f849c,#1e1e2e'                # overlay1,overlay1,base
tmux_conf_theme_status_right_bg='#1e1e2e,#45475a,#6c7086'                # base,surface1,overlay0
tmux_conf_theme_status_right_attr='none,none,bold'

# pairing indicator
tmux_conf_theme_pairing='👓 '          # U+1F453
tmux_conf_theme_pairing_fg='none'
tmux_conf_theme_pairing_bg='none'
tmux_conf_theme_pairing_attr='none'

# synchronized indicator
tmux_conf_theme_synchronized='🔒'     # U+1F512
tmux_conf_theme_synchronized_fg='none'
tmux_conf_theme_synchronized_bg='none'
tmux_conf_theme_synchronized_attr='none'

# prefix indicator
tmux_conf_theme_prefix="🔼"           # U+1F53C
tmux_conf_theme_prefix_fg="none"
tmux_conf_theme_prefix_bg="none"
tmux_conf_theme_prefix_attr="none"

# mouse indicator
# tmux_conf_theme_mouse="🖱️"            # U+1F5B1
tmux_conf_theme_mouse="🐁"            # U+1F401
tmux_conf_theme_mouse_fg="none"
tmux_conf_theme_mouse_bg="none"
tmux_conf_theme_mouse_attr="bold"

# clock style (when you hit <prefix> + t)
# you may want to use %I:%M %p in place of %R in tmux_conf_theme_status_right
tmux_conf_theme_clock_colour='#89b4fa'  # blue
tmux_conf_theme_clock_style='24'

# Copy-mode keybinds
bind Escape copy-mode

# Log output to a text file on demand
bind C-q {
  pipe-pane -o "mkdir -p ~/.tmux/logs && cat >>~/.tmux/logs/#W-#P.log"
  display " Toggled logging to ~/.tmux/logs/#W-#P.log"
}

# Add keybinds with modifiers to use the original with other commands
bind-key 'M-s' choose-session -Z
bind-key 'M-w' choose-window -Z

# Prefix ! will split the current pane into it's own window.  To join use
# Prefix W then give the window number at the prompt
bind W command-prompt -p "Create pane from:" "join-pane -s ':%%'"

# toggle synchronize-panes
bind C-x setw synchronize-panes

# override buffer keybinds
bind C-b choose-buffer -Z # choose which buffer to paste from

# reorganize current pane with previous-number pane
bind M-, move-pane -t '.-' # previous at the top, current at the bottom
bind M-. move-pane -h -t '.-' # previous at the left, current at the right

# swap current pane with the pane geometrically adjacent in a direction,
# repeatable within repeat-time so you can hold prefix and tap the arrow
# a few times in a row. swap-pane alone leaves the active flag on the
# original position, not on the pane you just moved -- chaining
# select-pane with the same direction re-resolves it after the swap so
# focus follows your pane as it hops across the layout.
bind -r M-Left swap-pane -t '{left-of}' \; select-pane -t '{left-of}'
bind -r M-Right swap-pane -t '{right-of}' \; select-pane -t '{right-of}'
bind -r M-Up swap-pane -t '{up-of}' \; select-pane -t '{up-of}'
bind -r M-Down swap-pane -t '{down-of}' \; select-pane -t '{down-of}'

# toggle mouse
bind-key M {
  set-option -gF mouse "#{?mouse,off,on}"
  display-message "#{?mouse,Mouse: ON,Mouse: OFF}"
}

# Pane actions
# binding to enter marked-pane-actions prefix
bind-key m {
  switch-client -T marked-pane-actions
  display-message "Marked pane actions mode"
}
# mark/unmark the active pane
bind-key -T marked-pane-actions m select-pane -m
# unmark the marked pane from any window/pane
bind-key -T marked-pane-actions M select-pane -M
# go to the marked pane
bind-key -T marked-pane-actions g switch-client -t '{marked}'
# swap the current pane with the marked
bind-key -T marked-pane-actions s swap-pane
# swap the current window with the one containing the marked pane
bind-key -T marked-pane-actions w swap-window
# join(move) the marked pane to the current window next to the current pane
bind-key -T marked-pane-actions j join-pane
# disable the current pane so as not to run commands in synchronised mode
bind-key -T marked-pane-actions d select-pane -d \; display-message "Pane disabled"
# enable a previously disabled pane
bind-key -T marked-pane-actions e select-pane -e \; display-message "Pane enabled"
# swap the current pane with the pane geometrically adjacent in a direction;
# -r keeps this table active for repeated taps within repeat-time, so you
# can shuffle a pane around with just the arrow keys and it drops back to
# normal mode on its own once you stop pressing. swap-pane alone leaves the
# active flag on the original position, not on the pane you just moved --
# chaining select-pane with the same direction re-resolves it after the
# swap so focus follows your pane as it hops across the layout, letting
# repeated presses (even mixed directions) keep tracking the same pane.
bind-key -r -T marked-pane-actions Left swap-pane -t '{left-of}' \; select-pane -t '{left-of}'
bind-key -r -T marked-pane-actions Right swap-pane -t '{right-of}' \; select-pane -t '{right-of}'
bind-key -r -T marked-pane-actions Up swap-pane -t '{up-of}' \; select-pane -t '{up-of}'
bind-key -r -T marked-pane-actions Down swap-pane -t '{down-of}' \; select-pane -t '{down-of}'

# Start rectangle (block) selection in copy-mode
bind-key -T copy-mode-vi 'C-v' send -X begin-selection \; send -X rectangle-toggle

# Create a new window preserving the path of the current pane
bind-key c run-shell 'tmux new-window -c "$(echo "#{pane_current_path}")"'

bind-key -r i run-shell "tmux neww tmux-cht.sh"

# Compatibility with fzf-git.sh
bind-key -n -T root C-g switch-client -T ctrl_g_mode
bind-key -T ctrl_g_mode C-B send-keys C-g C-B
bind-key -T ctrl_g_mode C-E send-keys C-g C-E
bind-key -T ctrl_g_mode C-F send-keys C-g C-F
bind-key -T ctrl_g_mode C-H send-keys C-g C-H
bind-key -T ctrl_g_mode C-L send-keys C-g C-L
bind-key -T ctrl_g_mode C-R send-keys C-g C-R
bind-key -T ctrl_g_mode C-S send-keys C-g C-S
bind-key -T ctrl_g_mode C-T send-keys C-g C-T
bind-key -T ctrl_g_mode C-W send-keys C-g C-W
bind-key -T ctrl_g_mode C-G send-keys C-g C-G # used by fzf-marks
bind-key -T ctrl_g_mode b send-keys C-g b
bind-key -T ctrl_g_mode e send-keys C-g e
bind-key -T ctrl_g_mode f send-keys C-g f
bind-key -T ctrl_g_mode h send-keys C-g h
bind-key -T ctrl_g_mode l send-keys C-g l
bind-key -T ctrl_g_mode r send-keys C-g r
bind-key -T ctrl_g_mode s send-keys C-g s
bind-key -T ctrl_g_mode t send-keys C-g t
bind-key -T ctrl_g_mode w send-keys C-g w
bind-key -T ctrl_g_mode g send-keys C-g g # used by fzf-marks
